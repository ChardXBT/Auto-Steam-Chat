# Copy to .env (gitignored) and fill in. Nothing in this file is required for
# the service to start: a missing or malformed value disables only that sink,
# and every DM is still written to runtime/messages.jsonl.
#
# Steam credentials are NOT configured here. Run `npm run signin` once per
# account; it saves only a refresh token under runtime/accounts/<account>/.

# Discord incoming webhook for the relay channel.
# Format: https://discord.com/api/webhooks/<id>/<token>
DISCORD_WEBHOOK_URL=

# Your Discord user ID (Developer Mode > right-click yourself > Copy User ID).
# Relayed DMs mention <@this id> so Discord pings you.
DISCORD_MENTION_USER_ID=

# Same bot and chat as cs-notifier.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
