{
  "name": "auto-steam-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Relays inbound Steam direct messages on S | Skins and Rukia | Skins to Discord and Telegram",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/index.js start",
    "signin": "node dist/index.js signin",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.12"
  },
  "license": "MIT",
  "dependencies": {
    "steam-totp": "^2.1.2",
    "steam-user": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/steam-totp": "^2.1.2",
    "@types/steam-user": "^5.1.1",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
